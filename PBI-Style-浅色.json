{
  "name": "PBI-Style-浅色",
  "dataColors": [
    "#2E7DD1",
    "#7C6FD0",
    "#A9CDED",
    "#2FA572",
    "#E0603C",
    "#A8A6A0",
    "#86847F",
    "#C4C4C4"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "verticalSpacing": 8
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E1E5EA"
              }
            },
            "show": true,
            "radius": 8
          }
        ],
        "title": [
          {
            "show": false,
            "text": "Title",
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1F2733"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "titleColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "titleFontSize": 12,
            "titleFontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDEFF2"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "titleColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "titleFontSize": 12,
            "titleFontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDEFF2"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted",
            "labelDisplayUnits": 1,
            "secLabelDisplayUnits": 1
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false,
            "markerSize": 4
          }
        ],
        "labels": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#00000000"
              }
            },
            "color": {
              "solid": {
                "color": "#1F2733"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "show": true,
            "labelDisplayUnits": 1,
            "optimizeLabelDisplay": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "*": [
          {
            "verticalAlignment": "Middle"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E6E9ED"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          { "show": true },
          {
            "$id": "default",
            "transparency": 0,
            "fillColor": { "solid": { "color": "#2E3A45" } }
          }
        ],
        "outline": [
          { "show": true },
          {
            "$id": "default",
            "show": false,
            "lineColor": { "solid": { "color": "#E1E5EA" } }
          }
        ],
        "border":[
          {
            "show":false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#2E3A45"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#3A4854"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "disabled",
            "fillColor": {
              "solid": {
                "color": "#2E3A45"
              }
            },
            "show": true,
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": false
          },
          {
            "$id": "selected",
            "show": false
          },
          {
            "$id": "disabled",
            "show": false
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#C5CED6"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#2E3A45"
              }
            },
            "bold": true
          },
          {
            "$id": "disabled",
            "fontColor": {
              "solid": {
                "color": "#78909C"
              }
            }
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": false
          },
          {
            "$id": "selected",
            "color": {
              "solid": {
                "color": "#2E7DD1"
              }
            },
            "position": "Left",
            "show": true,
            "width": 3
          },
          {
            "$id": "disabled",
            "show": false
          }
        ]
      }
    },
    "bookmarkNavigator": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#F0F4F8"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#EFF6FC"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "disabled",
            "fillColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "show": true,
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E1E5EA"
              }
            },
            "weight": 1
          },
          {
            "$id": "hover",
            "show": false
          },
          {
            "$id": "selected",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#2E7DD1"
              }
            },
            "weight": 1
          },
          {
            "$id": "disabled",
            "show": false
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#605E5C"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#1F2733"
              }
            }
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#1F2733"
              }
            },
            "bold": true
          },
          {
            "$id": "disabled",
            "fontColor": {
              "solid": {
                "color": "#BFBFBF"
              }
            }
          }
        ]
      }
    }
  }
}
