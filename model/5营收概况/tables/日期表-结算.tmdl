		sourceColumn: [年月排序]

		annotation SummarizationSetBy = Automatic

	partition 日期表-结算 = calculated
		mode: import
		source = ```
				
				VAR stardate = MIN('猿推库团长订单'[结算日期])  
				VAR enddate = MAX('猿推库团长订单'[结算日期])
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR (stardate, enddate),
				    "日期", [Date],
				    "年份", YEAR([Date]),
				    "季度", "第" & QUARTER([Date]) & "季度",
				    "月份号", MONTH([Date]),
				    "月份名称", FORMAT([Date], "MMMM"),
				    "周数", WEEKNUM([Date], 2),
				    "星期几号", WEEKDAY([Date], 2),
				    "星期几名称", FORMAT([Date], "dddd"),
				    "年月", FORMAT([Date], "YYYY-MM"),
				    "年月排序", FORMAT([Date], "YYYYMM")
				)
				```

	annotation PBI_Id = 640ef190b27642d9b81a6e9444af22df

