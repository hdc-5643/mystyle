	measure SVG页面标题 = ```
			
			VAR TitleText = "销售总览" //可以替换成度量动态文本，例如 CONCATENATE("(" & SELECTEDVALUE('日期'[年月]) & ") 销售总览")
			VAR SvgStr = 
			"<svg xmlns='http://www.w3.org/2000/svg' width='450' height='60'>
			  <!-- 小图标svg -->
			  <circle cx='25' cy='30' r='18' fill='#2F80ED'/>
			  <text x='25' y='36' fill='white' font-size='20' text-anchor='middle'>📊</text>
			  <!-- 标题文字 -->
			  <text x='65' y='38' font-size='28' font-weight='bold' fill='#222'>" & TitleText & "</text>
			</svg>"
			RETURN
			"data:image/svg+xml;utf8," & SvgStr
			
			```
		lineageTag: bb48d682-d499-4290-bf61-c80e33a1da53

