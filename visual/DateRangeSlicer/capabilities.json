                    "displayName": "用户是否手动改过区间（兼容旧版本遗留标志）",
                    "type": {
                        "bool": true
                    }
                },
                "currentPreset": {
                    "displayName": "当前选中的预设（thisMonth/lastMonth/last7/last15/last30）",
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "customRange": {
            "displayName": "自定义区间（持久化，勿在格式面板中改动）",
            "properties": {
                "customStart": {
                    "displayName": "自定义开始日期（ISO，本地时区）",
                    "type": {
                        "text": true
                    }
                },
                "customEnd": {
                    "displayName": "自定义结束日期（ISO，本地时区）",
                    "type": {
                        "text": true
                    }
                }
            }
        }
    }
