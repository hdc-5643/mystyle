{
    "privileges": [],
    "dataRoles": [
        {
            "displayName": "日期/文本字段",
            "description": "要筛选的字段。预设模式下应为日期字段；列表模式下日期与文本字段均可。",
            "name": "Date",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "Date": {
                        "max": 1,
                        "min": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "Date"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
