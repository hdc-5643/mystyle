{
    "privileges": [],
    "dataRoles": [
        {
            "displayName": "日期/文本字段",
            "description": "要筛选的字段。预设模式下应为日期字段；列表模式下日期与文本字段均可。",
            "name": "Date",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "Date": {
                        "max": 1,
                        "min": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "Date"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "mode": {
            "displayName": "切片器模式",
            "properties": {
                "mode": {
                    "displayName": "模式",
                    "type": {
                        "enumeration": [
                            {
                                "value": "preset",
                                "displayName": "预设区间（本月/上月/近N天）"
                            },
                            {
                                "value": "list",
                                "displayName": "值列表（字段唯一值，多选）"
                            }
                        ]
                    }
                }
            }
        },
        "general": {
            "displayName": "常规",
            "properties": {
                "filter": {
                    "type": {
                        "filter": true
                    }
                }
            }
        },
        "header": {
            "displayName": "切片器标头",
            "properties": {
            "show": {
                "displayName": "标头",
                "type": {
                    "bool": true
                }
            },
            "title": {
                "displayName": "标题文字",
                "type": {
                    "text": true
                }
            },
            "position": {
                "displayName": "文本位置",
                "type": {
                    "enumeration": [
                        {
                            "value": "top",
                            "displayName": "上方"
                        },
                        {
                            "value": "left",
                            "displayName": "左侧"
                        }
                    ]
                }
            },
                "fontColor": {
                    "displayName": "字体颜色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "background": {
                    "displayName": "背景色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontSize": {
                    "displayName": "字体大小",
                    "type": {
                        "numeric": true
                    }
                },
                "fontFamily": {
                    "displayName": "字体",
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "bold": {
                    "displayName": "粗体",
                    "type": {
                        "bool": true
                    }
                },
                "italic": {
                    "displayName": "斜体",
                    "type": {
                        "bool": true
                    }
                },
                "underline": {
                    "displayName": "下划线",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "selection": {
            "displayName": "下拉样式",
            "properties": {
                "backgroundColor": {
                    "displayName": "背景色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderColor": {
                    "displayName": "边框颜色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderWidth": {
                    "displayName": "边框粗细",
                    "type": {
                        "numeric": true
                    }
                },
                "borderRadius": {
                    "displayName": "圆角",
                    "type": {
                        "numeric": true
                    }
                },
                "accentColor": {
                    "displayName": "强调色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listBackground": {
                    "displayName": "下拉面板背景色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listText": {
                    "displayName": "下拉面板文字色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listHoverText": {
                    "displayName": "悬浮文字色（只变字、不动背景）",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listHoverBackground": {
                    "displayName": "悬浮背景色（默认透明=不变灰）",
