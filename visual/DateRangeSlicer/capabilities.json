                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "triggerFontSize": {
                    "displayName": "触发器文字大小",
                    "type": {
                        "numeric": true
                    }
                },
                "listActiveText": {
                    "displayName": "选中态文字色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listActiveBackground": {
                    "displayName": "选中态背景色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "scrollbarTrackColor": {
                    "displayName": "滚动条轨道色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "scrollbarThumbColor": {
                    "displayName": "滚动条滑块色",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "listGap": {
                    "displayName": "行间距（列表项之间的间距，0-12）",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "listBehavior": {
            "displayName": "列表模式行为",
            "properties": {
                "showSearch": {
                    "displayName": "显示搜索框",
                    "type": {
                        "bool": true
                    }
                },
                "showSelectAll": {
                    "displayName": "显示「（全选）」项",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "defaultBehavior": {
            "displayName": "默认行为",
            "properties": {
                "defaultThisMonth": {
                    "displayName": "默认本月（首次加载自动套最新日期所在月）",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "state": {
            "displayName": "内部状态（持久化，勿在格式面板中改动）",
            "properties": {
