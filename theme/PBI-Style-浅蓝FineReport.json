{
  "name": "PBI-Style-浅蓝FineReport",
  "dataColors": [
    "#3B6CB4",
    "#6A9BD5",
    "#A4C7F0",
    "#5CB85C",
    "#E8913A",
    "#9AA5B1",
    "#7D8692",
    "#B8C0C8"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "verticalSpacing": 8
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#DCE3EA"
              }
            },
            "show": true,
            "radius": 6
          }
        ],
        "title": [
          {
            "show": false,
            "text": "Title",
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#2C3E50"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5A6572"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "titleColor": {
              "solid": {
                "color": "#5A6572"
              }
            },
            "titleFontSize": 12,
            "titleFontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E8EDF2"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted",
            "labelDisplayUnits": 1,
            "secLabelDisplayUnits": 1
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5A6572"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "titleColor": {
              "solid": {
                "color": "#5A6572"
              }
            },
            "titleFontSize": 12,
            "titleFontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E8EDF2"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted",
            "labelDisplayUnits": 1,
            "secLabelDisplayUnits": 1
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "showMarker": false,
            "markerSize": 4
          }
        ],
        "labels": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#00000000"
              }
            },
            "color": {
              "solid": {
                "color": "#2C3E50"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "show": true,
            "labelDisplayUnits": 1,
            "optimizeLabelDisplay": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "*": [
          {
            "verticalAlignment": "Middle"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F6F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "fill": [
          {
            "show": true
          },
          {
            "$id": "default",
            "transparency": 0,
            "fillColor": { "solid": { "color": "#3B6CB4" } }
          }
        ],
        "outline": [
          {
            "show": true
          },
          {
            "$id": "default",
            "show": false,
            "lineColor": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textSlicer": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "top": 5,
            "bottom": 5,
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 6
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#3B6CB4"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#4A7BC0"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "disabled",
            "fillColor": {
              "solid": {
                "color": "#3B6CB4"
              }
            },
            "show": true,
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#5A8BC8"
              }
            },
            "weight": 1
          },
          {
            "$id": "hover",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#8AA3C3"
              }
            },
            "weight": 1
          },
          {
            "$id": "selected",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#3B6CB4"
              }
            },
            "weight": 1
          },
          {
            "$id": "disabled",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#2E568F"
              }
            },
            "weight": 1
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#1F4E8C"
              }
            },
            "bold": true
          },
          {
            "$id": "disabled",
            "fontColor": {
              "solid": {
                "color": "#8AA3C3"
              }
            }
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": false
          },
          {
            "$id": "selected",
            "color": {
              "solid": {
                "color": "#1F4E8C"
              }
            },
            "position": "Left",
            "show": true,
            "width": 4
          },
          {
            "$id": "disabled",
            "show": false
          }
        ]
      }
    },
    "bookmarkNavigator": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "top": 5,
            "bottom": 5,
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 6
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 6
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#F0F4F9"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#3B6CB4"
              }
            },
            "show": true,
            "transparency": 0
          },
          {
            "$id": "disabled",
            "fillColor": {
              "solid": {
                "color": "#F0F4F9"
              }
            },
            "show": true,
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E8EDF2"
              }
            },
            "weight": 1
          },
          {
            "$id": "hover",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#DCE3EA"
              }
            },
            "weight": 1
          },
          {
            "$id": "selected",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#3B6CB4"
              }
            },
            "weight": 1
          },
          {
            "$id": "disabled",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E8EDF2"
              }
            },
            "weight": 1
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#5A6572"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#2C3E50"
              }
            }
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          },
          {
            "$id": "disabled",
            "fontColor": {
              "solid": {
                "color": "#B0B8C0"
              }
            }
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": false
          },
          {
            "$id": "selected",
            "show": false
          },
          {
            "$id": "disabled",
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#00000000"
              }
            },
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#2C3E50"
              }
            }
          }
        ]
      }
    }
  }
}
